name: ci
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m unittest discover -s tests -v
      - run: python demo.py
      - name: CLI gate check (HALT must exit 2)
        run: |
          python -m guardian.cli check examples/halt_wire_transfer.json --ledger ci_audit.jsonl; test $? -eq 2
          python -m guardian.cli verify --ledger ci_audit.jsonl
